# 接口故障根因定位 —— 凭据与配置位清单
#
# 全部凭据一律从**环境变量**读取，程序不内置任何真实主机、账号、口令或令牌。
# 本文件只列「位」与占位说明；把下列每一行按实际值写进值班机的环境变量或密钥管理里。
# 缺任一必需位时，程序启动即报明确错误码并指出缺哪一项、从哪个环境变量读，
# **不会**退回本地替身或示例数据继续跑。

# ── ① 院内 ESB / API 网关 接口调用流水库（MySQL wire，只读账号）────────────────
ESB_AUDIT_DB_HOST=<院内 ESB 流水库地址>
ESB_AUDIT_DB_PORT=<端口，默认 3306>
ESB_AUDIT_DB_USER=<只读账号>
ESB_AUDIT_DB_PASSWORD=<只读账号口令>
ESB_AUDIT_DB_NAME=<流水库名>

# ── ② 主机与中间件指标（Prometheus HTTP 只读）────────────────────────────────
PROM_BASE_URL=<院内指标端点地址>
PROM_BEARER_TOKEN=<指标端点访问令牌>

# ── ③ 应用与网关错误日志目录（只读，增量 tail）───────────────────────────────
ESB_LOG_DIR=<ESB 网关错误日志目录绝对路径>
APP_LOG_DIR=<应用错误日志目录绝对路径>

# ── ④ 院内运维工单系统（主路径终点，HTTP POST 写）────────────────────────────
OPS_TICKET_BASE_URL=<运维工单系统地址>
OPS_TICKET_TOKEN=<工单系统访问令牌>

# ── ⑤ 归因模型端点（OpenAI-compatible 一种协议；缺失时走规则基线并标注降级）──
MODEL_BASE_URL=<模型服务端点地址>
MODEL_API_KEY=<模型服务访问密钥>
MODEL_NAME=<模型名称>
MODEL_TIMEOUT_SEC=30
MODEL_MAX_RETRIES=2
